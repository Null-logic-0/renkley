<% content_for :title, "Resend confirmation — Renkley" %>

<h1 class="rk-auth-title">Resend confirmation</h1>
<p class="rk-auth-subtitle">Enter your email and we&rsquo;ll send you a new confirmation link.</p>

<%= form_with url: confirmations_path do %>
  <%= render "shared/input", label: "Work email", name: "email_address", type: "email",
        placeholder: "you@company.com", value: params[:email_address], required: true,
        html: { autofocus: true, autocomplete: "username" } %>

  <%= render "shared/button", label: "Send confirmation link", variant: :primary, full_width: true, type: "submit" %>
<% end %>

<p class="rk-auth-note">We&rsquo;ll email you a secure link to confirm your account. It expires in 24 hours.</p>

<p class="rk-auth-switch">Already confirmed? <%= link_to "Back to sign in", new_session_path %></p>
