<%
  modal_id = "edit-prompt-#{p[:prompt_id]}"
  form_id  = "edit_prompt_form_#{p[:prompt_id]}"
  trigger = capture do
    tag.button type: "button", class: "rk-ov-row-action-btn", title: "Edit prompt", aria: { label: "Edit prompt" } do
      shared_icon(:pencil, size: 14)
    end
  end
  actions = capture do %>
    <%= render "shared/button", label: "Cancel", variant: :secondary, html: { data: { action: "click->modal#close" } } %>
    <%= render "shared/button", label: "Save changes", variant: :primary, type: "submit", html: { form: form_id } %>
  <% end
%>
<%= render layout: "shared/modal", locals: { title: "Edit tracked prompt", trigger: trigger, actions: actions, id: modal_id } do %>
  <%= form_with url: prompt_path(p[:prompt_id]), method: :patch, id: form_id, data: { turbo_stream: true } do %>
    <%= render "prompts/form_fields", field_id: p[:prompt_id], body: p[:prompt], search_volume: p[:volume] %>
  <% end %>
<% end %>
