<% content_for :title, "Reset your password — Renkley" %>

<h1 class="rk-auth-title">Reset your password</h1>
<p class="rk-auth-subtitle">Enter your email and we&rsquo;ll send you a reset link.</p>

<%= form_with url: passwords_path do %>
  <%= render "shared/input", label: "Work email", name: "email_address", type: "email",
        placeholder: "you@company.com", value: params[:email_address], required: true,
        html: { autofocus: true, autocomplete: "username" } %>

  <%= render "shared/button", label: "Send reset link", variant: :primary, full_width: true, type: "submit" %>
<% end %>

<p class="rk-auth-note">We&rsquo;ll email you a secure link to reset your password. It expires in 30 minutes.</p>

<p class="rk-auth-switch">Remembered it? <%= link_to "Back to sign in", new_session_path %></p>
