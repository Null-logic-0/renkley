<%= render layout: "shared/card", locals: { title: "Password", subtitle: "Update the password used to sign in to Renkley." } do %>
  <div data-controller="password-validation">
    <%= render "shared/input", name: "current_password", label: "Current password", type: "password" %>

    <div class="columns">
      <div class="column is-6">
        <%= render "shared/input", name: "password", label: "New password", type: "password",
              html: { data: { password_validation_target: "password", action: "input->password-validation#check" } } %>
      </div>
      <div class="column is-6">
        <%= render "shared/input", name: "password_confirmation", label: "Confirm new password", type: "password",
              html: { data: { password_validation_target: "confirmation", action: "input->password-validation#check" } } %>
      </div>
    </div>

    <div class="rk-check-list" aria-live="polite">
      <%= render "shared/checklist_item", label: "At least 8 characters",
            html: { data: { password_validation_target: "length" } } %>
      <%= render "shared/checklist_item", label: "Contains a letter and a number",
            html: { data: { password_validation_target: "complexity" } } %>
      <%= render "shared/checklist_item", label: "Passwords match",
            html: { data: { password_validation_target: "match" } } %>
    </div>
  </div>
<% end %>
