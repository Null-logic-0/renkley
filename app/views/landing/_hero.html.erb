<section class="rk-divide">
  <div class="rk-container rk-hero-grid rk-hero-section">
    <div>
      <div class="rk-badge mb-5">
        <span class="rk-dot"></span>
        <span>Now tracking Gemini</span>
      </div>
      <h1 class="rk-hero-title">Your competitors are showing up in ChatGPT. Are you?</h1>
      <p class="rk-hero-lead">Renkley tracks how often your brand appears across ChatGPT, Claude,
        Gemini. Benchmark competitors, find optimization gaps, and grow your AI
        search visibility with actionable recommendations.</p>
      <div class="rk-hero-actions">
        <%= render "landing/cta_button", variant: :lg %>
      </div>
      <div class="rk-hero-meta">
        <span class="rk-hero-meta-item"><%= rk_icon(:check, size: 14) %>7-day free trial</span>
      </div>
    </div>

    <%= render "landing/dashboard_mockup",
    visibility_score: visibility_score,
    hero_platforms: hero_platforms %>
  </div>
</section>
