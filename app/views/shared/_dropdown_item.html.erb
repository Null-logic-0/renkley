<% label = local_assigns.fetch(:label)
icon = local_assigns[:icon]
href = local_assigns[:href]
to = local_assigns[:to]
method = local_assigns[:method]
variant = local_assigns[:variant]
html = local_assigns.fetch(:html, {})

css_class = [
  "dropdown-item",
  ("is-danger" if variant == :danger),
  html[:class],
].compact.join(" ")

html_rest = html.except(:class) %>

<% content = capture do %>
  <% if icon.present? %>
    <%= shared_icon(icon, size: 16) %>
  <% end %>
  <%= label %>
<% end %>

<% if to.present? %>
  <%= button_to to, method: method, class: css_class, form: { class: "dropdown-item-form" }, **html_rest do %>
    <%= content %>
  <% end %>
<% elsif href.present? %>
  <%= link_to content, href, class: css_class, **html_rest %>
<% else %>
  <%= content_tag :button, content, type: "button", class: css_class, **html_rest %>
<% end %>
