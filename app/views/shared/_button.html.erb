<%
  # Renders a Bulma <button>/<a class="button"> in one of the brand variants.
  #
  # Locals:
  #   label:       button text (required)
  #   variant:     :primary (default) | :secondary | :ghost | :destructive | :destructive_outline
  #   href:        renders an <a> instead of a <button> when present
  #   to:          renders a button_to form posting to this path (takes precedence
  #                over href); type: and disabled: do not apply in this mode
  #   method:      HTTP verb for `to:` — :post (default) | :delete | ...
  #   turbo:       true (default) — pass false for `to:` forms that redirect off-site,
  #                since Turbo cannot follow a cross-origin redirect
  #   type:        "button" (default) | "submit" — ignored when href or to is given
  #   full_width:  false
  #   loading:     false — shows Bulma's built-in button spinner
  #   disabled:    false
  #   icon:        raw SVG markup rendered before the label, e.g. a brand mark
  #   html:        {} — extra attributes merged onto the tag (data-*, id, etc.)
  label      = local_assigns.fetch(:label)
  variant    = local_assigns.fetch(:variant, :primary)
  href       = local_assigns[:href]
  to         = local_assigns[:to]
  method     = local_assigns.fetch(:method, :post)
  turbo      = local_assigns.fetch(:turbo, true)
  type       = local_assigns.fetch(:type, "button")
  full_width = local_assigns.fetch(:full_width, false)
  loading    = local_assigns.fetch(:loading, false)
  disabled   = local_assigns.fetch(:disabled, false)
  icon       = local_assigns[:icon]
  html       = local_assigns.fetch(:html, {})

  variant_class = {
    primary: "is-primary",
    secondary: "rk-btn-outline",
    ghost: "is-ghost",
    destructive: "is-danger",
    destructive_outline: "is-danger is-outlined"
  }.fetch(variant.to_sym)

  classes = ["button", variant_class]
  classes << "is-fullwidth" if full_width
  classes << "is-loading" if loading
  css_class = [*classes, html[:class]].compact.join(" ")
  tag_options = html.except(:class).merge(class: css_class)

  content = icon.present? ? content_tag(:span, safe_join([icon.html_safe, label]), class: "rk-btn-content") : label
%>
<% if to %>
  <%= button_to content, to, method: method,
        form: { data: turbo ? nil : { turbo: false } },
        **tag_options %>
<% elsif href %>
  <%= link_to content, href, **tag_options %>
<% else %>
  <%= content_tag :button, content, type: type, disabled: disabled, **tag_options %>
<% end %>
